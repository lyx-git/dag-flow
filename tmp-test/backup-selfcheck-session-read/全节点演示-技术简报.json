    {
      "from": "merge_ab",
      "to": "manual_ok"
    },
    {
      "from": "merge_ab",
      "to": "subflow_call"
    },
    {
      "from": "http_probe",
      "to": "log_http"
    },
    {
      "from": "log_http",
      "to": "end_final"
    },
    {
      "from": "web_search1",
      "to": "web_fetch1"
    },
    {
      "from": "web_search1",
      "to": "loop_over"
    },
    {
      "from": "web_fetch1",
      "to": "end_final"
    },
    {
      "from": "session_read",
      "to": "end_final"
    },
    {
      "from": "loop_demo",
      "to": "end_final"
    },
    {
      "from": "loop_over",
      "to": "end_final"
    },
    {
      "from": "manual_ok",
      "to": "ai_summary"
    },
    {
      "from": "subflow_call",
      "to": "end_final"
    },
    {
      "from": "ai_summary",
      "to": "if_has_search"
    },
    {
      "from": "ai_summary",
      "to": "switch_mode"
    },
    {
      "from": "if_has_search",
      "to": "file_save_report",
      "when": "true"
    },
    {
      "from": "if_has_search",
      "to": "log_no_result",
      "when": "false"
    },
    {
      "from": "file_save_report",
      "to": "end_final"
    },
    {
      "from": "log_no_result",
      "to": "end_final"
    },
    {
      "from": "switch_mode",
      "to": "log_mode",
      "when": "quick"
    },
    {
      "from": "log_mode",
      "to": "end_final"
    },
    {
      "from": "switch_mode",
      "to": "log_mode",
      "when": "image"
    },
    {
      "from": "image_gen",
      "to": "end_final"
    },
    {
      "from": "switch_mode",
      "to": "image_gen",
      "when": "full"
    },
    {
      "from": "video_gen",
      "to": "end_final"
    },
    {
      "from": "switch_mode",
      "to": "video_gen",
      "when": "video"
    }
  ],
