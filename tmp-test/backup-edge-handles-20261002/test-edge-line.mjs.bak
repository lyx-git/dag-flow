// tmp-test/cdp/test-edge-line.mjs — 边缘起线 + 快选面板跟随落点（2026-10-01 深夜用户需求）
// ① 节点内部按住拖动 = 移动节点（回归，不弹面板）；② 边缘把手按住拖出 = 画线，
//    哪里松开哪里弹快选面板；③ 面板里选节点 → 新节点创建并自动连线；④ 面板已收起。
// ★ 注意：mousemove/mouseup 必须派发到 document.body（页面内元素）——
//   直接派发到 window 的事件不经过 document capture，FlowGram 的 PlaygroundDrag
//   （document 监听）收不到，拖线无法建立。真实鼠标事件的目标总是页面内元素，无此问题。
export async function run({ cdp, evaluate, waitFor, ok, eq, sleep }) {
  await waitFor(cdp, `!!document.querySelector('.dsh-wf-fg-node-host')`, { timeout: 15000 });
  const nodes0 = await evaluate(cdp, `window.__df_def?.nodes?.length ?? -1`);

  // ① 内部按住拖动 → 节点移动、不弹面板
  const pos0 = await evaluate(cdp, `JSON.stringify(window.__df_node_pos('start'))`);
  await evaluate(cdp, `
    (() => {
      const h = document.querySelectorAll('.dsh-wf-fg-node-host')[0];
      const r = h.getBoundingClientRect();
      const x = r.left + r.width / 2, y = r.top + r.height / 2;
      h.dispatchEvent(new MouseEvent('mousedown', { bubbles: true, cancelable: true, clientX: x, clientY: y, button: 0 }));
      document.body.dispatchEvent(new MouseEvent('mousemove', { bubbles: true, cancelable: true, clientX: x + 60, clientY: y + 40 }));
      document.body.dispatchEvent(new MouseEvent('mouseup', { bubbles: true, cancelable: true, clientX: x + 60, clientY: y + 40 }));
    })();
    true;
  `);
  await sleep(300);
  const pos1 = await evaluate(cdp, `JSON.stringify(window.__df_node_pos('start'))`);
  ok(pos0 !== pos1, '内部拖动移动了节点（' + pos0 + ' → ' + pos1 + '）');
  ok(await evaluate(cdp, `!document.querySelector('.dsh-wf-fg-quick')`), '内部拖动不弹快选面板');

  // ② 边缘把手拖出 → 画线 + 面板在松手处弹出
  //    ★ mousedown 必须派发到把手元素（.dsh-wf-fg-edge.s）本身——host 原生监听按
  //      e.target.closest('.dsh-wf-fg-edge') 区分「画线/移动」，派发到 host 上
  //      target=host 会被当成内部拖动。用 start 节点（end 是终止节点，输出端口无效，
  //      createLine 会被拒绝——这本身是正确的校验行为）
  const edges0 = await evaluate(cdp, `window.__df_def?.edges?.length ?? -1`);
  await evaluate(cdp, `
    window.__df_mmoves = 0;
    document.addEventListener('mousemove', () => { window.__df_mmoves++; }, true);
    true;
  `);
  const stop = await evaluate(cdp, `
    (() => {
      const host = document.querySelector('.dsh-wf-fg-node-host[data-node-id="start"]');
      const handle = host.querySelector('.dsh-wf-fg-edge.s');
      if (!handle) return null;
      const hr = handle.getBoundingClientRect();
      const startX = hr.left + hr.width * 0.7, startY = hr.top + hr.height / 2;
      const editor = document.querySelector('.dsh-wf-fg-editor').getBoundingClientRect();
      const endX = editor.left + editor.width * 0.55, endY = editor.top + editor.height * 0.78;
      const target = document.querySelector('.dsh-wf-fg-editor');
      handle.dispatchEvent(new MouseEvent('mousedown', { bubbles: true, cancelable: true, clientX: startX, clientY: startY, button: 0 }));
      target.dispatchEvent(new MouseEvent('mousemove', { bubbles: true, cancelable: true, clientX: startX + 40, clientY: startY + 30 }));
      target.dispatchEvent(new MouseEvent('mousemove', { bubbles: true, cancelable: true, clientX: endX, clientY: endY }));
      target.dispatchEvent(new MouseEvent('mouseup', { bubbles: true, cancelable: true, clientX: endX, clientY: endY }));
      return { endX, endY };
    })();
  `);
  ok(!!stop, '找到了 start 节点的下边缘把手 .dsh-wf-fg-edge.s');
  await waitFor(cdp, `!!document.querySelector('.dsh-wf-fg-quick')`, { timeout: 5000 });
  const panelPos = await evaluate(cdp, `(() => {
    const q = document.querySelector('.dsh-wf-fg-quick').getBoundingClientRect();
    return { left: q.left, top: q.top, width: q.width, height: q.height };
  })()`);
  // 面板应在落点附近（面板服务内部有锚定偏移，放宽到 ±400px 验证「跟随」大方向）
  ok(Math.abs(panelPos.left - stop.endX) < 400 && Math.abs(panelPos.top - stop.endY) < 400,
    '快选面板弹出在松手落点附近（落点 ' + Math.round(stop.endX) + ',' + Math.round(stop.endY) +
    '；面板 ' + Math.round(panelPos.left) + ',' + Math.round(panelPos.top) + '）');

  // ③ 在面板里选「Python」节点类型 → 新节点创建（def 节点数 +1）并自动连线
  //    ★ 不能选第一项（NODE_PALETTE[0] 是 start，无输入端口）——buildLine 对无输入端口的
  //      节点会静默跳过连线（正确行为），测试必须选可接收连线的普通节点
  await evaluate(cdp, `
    (() => {
      const items = Array.from(document.querySelectorAll('.dsh-wf-fg-quick-item'));
      const item = items.find((el) => (el.textContent || '').includes('Python')) || items[2];
      const r = item.getBoundingClientRect();
      item.dispatchEvent(new MouseEvent('mousedown', { bubbles: true, cancelable: true, clientX: r.left + 5, clientY: r.top + 5 }));
    })();
    true;
  `);
  await waitFor(cdp, `(window.__df_def?.nodes?.length ?? 0) > ${nodes0 < 0 ? 0 : nodes0}`, { timeout: 8000 });
  const nodes1 = await evaluate(cdp, `window.__df_def.nodes.length`);
  const base = nodes0 < 0 ? 2 : nodes0; // __df_def 镜像未初始化时按 fixture 初始 2 节点兜底
  ok(nodes1 === base + 1, '快选面板选型后新建 1 个节点（' + base + '→' + nodes1 + '）');
  // 连线数 +1（选型时与节点一起建立 start→新节点 的连线）。★ 边的 def 变更晚于节点到达
  //   （onDragLineEnd 里 create → delay(20) → buildLine，镜像各自触发）——用 waitFor 而非立即读
  const ebase = edges0 < 0 ? 1 : edges0; // 镜像未初始化时按 fixture 初始 1 条边兜底
  await waitFor(cdp, `(window.__df_def?.edges?.length ?? 0) > ${ebase}`, { timeout: 8000 });
  const edges1 = await evaluate(cdp, `window.__df_def.edges.length`);
  ok(edges1 === ebase + 1, '选型后自动建立 1 条连线（' + ebase + '→' + edges1 + '）');

  // ④ 面板已收起
  await waitFor(cdp, `!document.querySelector('.dsh-wf-fg-quick')`, { timeout: 5000 });
}
